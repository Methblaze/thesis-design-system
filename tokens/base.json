  "typography": {
    "$description": "Text styles. Every text layer uses one of these.",
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "{font.size.34}",
        "lineHeight": "{font.line-height.40}",
        "letterSpacing": "-0.005em"
      },
      "$extensions": {
        "figma": {
          "name": "Display"
        }
      },
      "$description": "Use once per tab root for the screen greeting or title, such as Good afternoon."
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.serif}",
        "fontWeight": "{font.weight.medium}",
